{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roama-signal-quest",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "CLOUDFLARE_WORKER": "true",
    "RESEND_FROM_EMAIL": "ROAMA Signal Quest <info@roama.tech>",
    "RESEND_SENDER_DOMAIN_VERIFIED": "true"
  },
  "routes": [
    {
      "pattern": "signalquest.roama.tech",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "roama-signal-quest"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
